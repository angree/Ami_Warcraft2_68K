; w2-play.uae - the guest for PLAYING the AmiW2 port (the user's, never for timings, never restarted by agents).
; 68020, JIT off, max speed -70 % (user rule: test only like this), AGA + uaegfx RTG, 2 MB Chip + 64 MB Fast (Z3), real sound.
; Own boot disk copy (boot-play.hdf, read-only) and own Work: (work-play) - never shared with the test guest.
; build.sh also deploys w2 / w2setup there.
config_window_title=W2 PLAY (user) 68020 -70%
config_description=AmiW2 port - play: 68020 -70% no JIT, AGA + uaegfx, 2 MB chip, 64 MB Z3

cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=false
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=-700.0
cachesize=0
compforcesettings=false
chipset=aga
chipset_compatible=A4000
chipmem_size=4
fastmem_size=0
bogomem_size=0
z3mem_size=64

gfxcard_type=uaegfx
gfxcard_size=16

kickstart_rom_file=C:\temp\amiga_w2\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:C:\temp\amiga_w2\boot-play.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:C:\temp\amiga_w2\work-play,-128

gfx_width_windowed=820
gfx_height_windowed=620
gfx_fullscreen_amiga=false
gfx_linemode=double
gfx_api=1
gfx_vsync=false

use_gui=no
show_leds=true
; "interrupts" is emulated but silent - the play guest needs exact
sound_output=exact
win32.inactive_nosound=false
win32.minimized_nosound=false
win32.iconified_nosound=false
win32.inactive_pause=false
win32.minimized_pause=false
win32.iconified_pause=false
magic_mouse=true
magic_mousecursor=1
