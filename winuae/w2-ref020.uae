; w2-ref020.uae - THE REFERENCE MACHINE of the AmiW2 port (agents' test guest):
; 68020, no FPU, JIT off, CPU max speed throttled -70 % (cpu_throttle is in tenths of a percent).
; Every speed number is quoted for THIS config. AGA chipset + a uaegfx RTG board, so the same boot tests
; both backends (Work:w2.cfg backend=aga|rtg|ehb). 2 MB Chip + 64 MB Fast (Z3).
; Runtime on the SSD: D:\GITHUB\_AmiW2-poza-repo\emu (copied from the EU2 runtime). boot.hdf mounted READ-ONLY; its
; User-Startup runs Work:run (LF endings), which build.sh writes: Stack 2000000 + Work:jobrun (job queue).
; Start/stop ONLY with winuae\harness\start-w2.ps1 / stop-w2.ps1 (never kill WinUAE by name).
config_window_title=W2 TEST ref020 noJIT -80% (agents)
config_description=AmiW2 port - reference: 68020 no FPU, JIT off, -80%, AGA + uaegfx, 2 MB chip, 64 MB Z3

cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=false
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=-700.0
cachesize=0
chipset=aga
chipset_compatible=A4000
chipmem_size=4
fastmem_size=0
bogomem_size=0
z3mem_size=64

gfxcard_type=uaegfx
gfxcard_size=16

kickstart_rom_file=D:\GITHUB\_AmiW2-poza-repo\emu\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:D:\GITHUB\_AmiW2-poza-repo\emu\boot.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:D:\GITHUB\_AmiW2-poza-repo\emu\work,-128

gfx_width_windowed=820
gfx_height_windowed=620
gfx_fullscreen_amiga=false
gfx_linemode=double
; Direct3D: DirectDraw presents through an overlay and PrintWindow then sees one colour
gfx_api=1
gfx_vsync=false

use_gui=no
show_leds=true
; never sound_output=none: with it audio.device writes hang and everything is silent
sound_output=interrupts
win32.inactive_nosound=false
win32.minimized_nosound=false
win32.iconified_nosound=false
win32.inactive_pause=false
win32.minimized_pause=false
win32.iconified_pause=false
magic_mouse=true
magic_mousecursor=1
win32.start_not_captured=true
